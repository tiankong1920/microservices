# Auto detect text files and perform LF normalization
* text=auto

# Java source files
*.java text diff=java
*.kt text diff=kotlin
*.kts text diff=kotlin

# Gradle files
*.gradle text
*.gradle.kts text
gradlew text eol=lf
gradlew.bat text eol=crlf

# Configuration files
*.properties text
*.yml text
*.yaml text
*.xml text
*.json text

# Documentation
*.md text
*.txt text
*.adoc text

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Docker files
Dockerfile text
docker-compose*.yml text
.dockerignore text

# SQL files
*.sql text

# Binary files
*.jar binary
*.war binary
*.ear binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.keystore binary
*.jks binary

# Generated files
**/generated/** linguist-generated
**/target/** linguist-generated
**/build/** linguist-generated
