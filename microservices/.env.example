# =============================================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=inventory_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ── Nacos ────────────────────────────────────────────────────────────────────
NACOS_HOST=nacos
NACOS_PORT=8848

# ── JWT 认证 ─────────────────────────────────────────────────────────────────
# 最少 32 个字符，用于 HS256 签名
JWT_SECRET=your-minimum-32-characters-long-secret-key-here!!
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# ── OAuth2 ───────────────────────────────────────────────────────────────────
OAUTH2_CLIENT_ID=inventory-client
OAUTH2_CLIENT_SECRET=your-oauth2-client-secret
OAUTH2_REDIRECT_URI=http://localhost:3000/callback

# ── 数据加密 ─────────────────────────────────────────────────────────────────
# 用于发票/数据源服务的字段加密，最少 32 个字符
ENCRYPTION_SECRET_KEY=your-32-char-encryption-key!!

# ── CORS 跨域 ────────────────────────────────────────────────────────────────
AUTH_CORS_ORIGINS=http://localhost:3000

# ── Kafka（可选） ────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── SonarQube（可选） ────────────────────────────────────────────────────────
SONAR_TOKEN=your-sonar-token
