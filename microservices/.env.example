# =============================================================================
# Inventory Management System - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# Application
APP_NAME=inventory-management-system
APP_VERSION=3.0.0
SPRING_PROFILES_ACTIVE=dev

# Database - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234

# Database - H2 (Development)
H2_CONSOLE_ENABLED=true
H2_CONSOLE_PATH=/h2-console

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=inventory-group

# Nacos (Service Discovery & Config)
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=dev
NACOS_GROUP=DEFAULT_GROUP

# Security
JWT_SECRET=your_jwt_secret_key_here_at_least_256_bits
JWT_EXPIRATION=86400000

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_FILE_PATH=./logs

# Docker
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_TAG=latest

# Build
GRADLE_OPTS=-Xmx4g -Xms1g
JAVA_OPTS=-Xmx2g -Xms512m

# Development
DEBUG_PORT=5005
LIVE_RELOAD_ENABLED=true

# API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/swagger-ui.html

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# External Services (if any)
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_API_KEY=your_api_key_here
