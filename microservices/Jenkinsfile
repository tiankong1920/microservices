#!/usr/bin/env groovy

/**
 * Enterprise CI/CD Pipeline for Inventory Management System
 * 
 * This pipeline integrates:
 * - Security Scanning: Snyk, OWASP Dependency-Check, SonarQube
 * - Code Quality: Checkstyle, PMD, SpotBugs
 * - Compliance: OpenSCAP
 * - Monitoring: AppDynamics, Datadog, New Relic
 * - Collaboration: Jira, Slack
 * 
 * Build Tool: Gradle 8.6
 */

pipeline {
    agent any
    
    tools {
        gradle 'Gradle-8.6'
        jdk 'JDK-21'
    }
    
    environment {
        // Tool Credentials
        SONAR_TOKEN = credentials('sonar-token')
        SNYK_TOKEN = credentials('snyk-token')
        SLACK_WEBHOOK = credentials('slack-webhook')
        JIRA_CREDENTIALS = credentials('jira-credentials')
        
        // APM Configuration
        APPDYNAMICS_CONTROLLER_HOST = credentials('appdynamics-controller-host')
        APPDYNAMICS_ACCESS_KEY = credentials('appdynamics-access-key')
        DATADOG_API_KEY = credentials('datadog-api-key')
        NEW_RELIC_LICENSE_KEY = credentials('newrelic-license-key')
        
        // Build Configuration
        GRADLE_OPTS = '-Xmx4G -Xms1G -XX:+UseG1GC -XX:MaxMetaspaceSize=512m'
        DOCKER_REGISTRY = 'ghcr.io'
        IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        ansiColor('xterm')
        timeout(time: 2, unit: 'HOURS')
        disableConcurrentBuilds()
    }
    
    triggers {
        cron('H 18 * * *')  // Daily at 6 PM
        pollSCM('H/15 * * * *')  // Poll every 15 minutes
    }
    
    stages {
        // =====================================================================
        // Stage 1: Initialization
        // =====================================================================
        stage('Initialize') {
            steps {
                script {
                    echo "╔════════════════════════════════════════════════════════════╗"
                    echo "║     Enterprise CI/CD Pipeline - Inventory System          ║"
                    echo "║                    Build Tool: Gradle                     ║"
                    echo "╚════════════════════════════════════════════════════════════╝"
                    
                    // Set build display name
                    currentBuild.displayName = "#${env.BUILD_NUMBER} - ${env.GIT_BRANCH}"
                    
                    // Gather build info
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    
                    env.GIT_COMMIT_MSG = sh(
                        script: 'git log -1 --pretty=%B',
                        returnStdout: true
                    ).trim()
                    
                    env.GIT_AUTHOR = sh(
                        script: 'git log -1 --pretty=%an',
                        returnStdout: true
                    ).trim()
                    
                    echo "Branch: ${env.GIT_BRANCH}"
                    echo "Commit: ${env.GIT_COMMIT_SHORT}"
                    echo "Author: ${env.GIT_AUTHOR}"
                    echo "Message: ${env.GIT_COMMIT_MSG}"
                }
            }
        }
        
        // =====================================================================
        // Stage 2: Code Checkout and Setup
        // =====================================================================
        stage('Checkout') {
            steps {
                checkout scm
                
                // Make gradlew executable
                sh 'chmod +x gradlew'
                
                // Cache Gradle dependencies
                cache(maxCacheSize: 2048, caches: [
                    arbitraryFileCache(
                        path: '~/.gradle/caches',
                        cacheValidityDecidingFile: 'gradle.properties'
                    )
                ]) {
                    sh './gradlew --version'
                }
            }
        }
        
        // =====================================================================
        // Stage 3: Compilation
        // =====================================================================
        stage('Compile') {
            steps {
                sh './gradlew clean compileJava --no-daemon --stacktrace'
            }
            post {
                failure {
                    notifySlack('❌ Compilation Failed', 'danger')
                }
            }
        }
        
        // =====================================================================
        // Stage 4: Unit Tests
        // =====================================================================
        stage('Unit Tests') {
            steps {
                sh './gradlew test --no-daemon --stacktrace'
            }
            post {
                always {
                    junit testResults: '**/build/test-results/test/*.xml', allowEmptyResults: true
                    jacoco(
                        execPattern: '**/build/jacoco/test.exec',
                        classPattern: '**/build/classes/java/main',
                        sourcePattern: '**/src/main/java',
                        minimumLineCoverage: '80',
                        minimumBranchCoverage: '80'
                    )
                }
                failure {
                    notifySlack('❌ Unit Tests Failed', 'danger')
                }
            }
        }
        
        // =====================================================================
        // Stage 5: Code Quality Analysis
        // =====================================================================
        stage('Code Quality') {
            parallel {
                stage('Checkstyle') {
                    steps {
                        sh './gradlew checkstyleMain --no-daemon'
                    }
                    post {
                        always {
                            recordIssues(
                                enabledForFailure: true,
                                tools: [checkStyle(pattern: '**/build/reports/checkstyle/*.xml')]
                            )
                        }
                    }
                }
                stage('PMD') {
                    steps {
                        sh './gradlew pmdMain --no-daemon'
                    }
                    post {
                        always {
                            recordIssues(
                                enabledForFailure: true,
                                tools: [pmdParser(pattern: '**/build/reports/pmd/*.xml')]
                            )
                        }
                    }
                }
                stage('SpotBugs') {
                    steps {
                        sh './gradlew spotbugsMain --no-daemon'
                    }
                    post {
                        always {
                            recordIssues(
                                enabledForFailure: true,
                                tools: [spotBugs(pattern: '**/build/reports/spotbugs/*.xml')]
                            )
                        }
                    }
                }
            }
        }
        
        // =====================================================================
        // Stage 6: Security Scanning
        // =====================================================================
        stage('Security Scan') {
            parallel {
                stage('Snyk Dependency Scan') {
                    steps {
                        script {
                            try {
                                sh '''
                                    npm install -g snyk
                                    snyk auth ${SNYK_TOKEN}
                                    snyk test --all-projects --severity-threshold=medium --json-file-output=snyk-deps-results.json || true
                                '''
                            } catch (Exception e) {
                                echo "Snyk dependency scan completed with issues"
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'snyk-deps-results.json', allowEmptyArchive: true
                        }
                    }
                }
                stage('Snyk Code Scan') {
                    steps {
                        script {
                            try {
                                sh '''
                                    snyk code test --severity-threshold=medium --json-file-output=snyk-code-results.json || true
                                '''
                            } catch (Exception e) {
                                echo "Snyk code scan completed with issues"
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'snyk-code-results.json', allowEmptyArchive: true
                        }
                    }
                }
                stage('OWASP Dependency-Check') {
                    steps {
                        sh './gradlew dependencyCheckAnalyze --no-daemon'
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: '**/build/reports/dependency-check-report.html', allowEmptyArchive: true
                        }
                    }
                }
                stage('SonarQube Analysis') {
                    steps {
                        withSonarQubeEnv('SonarQube') {
                            sh '''
                                ./gradlew sonar \
                                    -Dsonar.projectKey=inventory-management-system \
                                    -Dsonar.projectName="Inventory Management System" \
                                    -Dsonar.projectVersion=${BUILD_NUMBER} \
                                    --no-daemon
                            '''
                        }
                    }
                }
            }
            post {
                failure {
                    notifySlack('⚠️ Security Scan Failed', 'warning')
                }
            }
        }
        
        // =====================================================================
        // Stage 7: Compliance Checks
        // =====================================================================
        stage('Compliance Check') {
            steps {
                script {
                    // OpenSCAP Security Scan
                    sh '''
                        if command -v oscap &> /dev/null; then
                            oscap xccdf eval \
                                --profile xccdf_org.ssgproject.content_profile_cis_level2_server \
                                --results compliance-results.xml \
                                --report compliance-report.html \
                                /usr/share/xml/scap/ssg/content/ssg-ubuntu2204-ds.xml || true
                        else
                            echo "OpenSCAP not installed, skipping compliance scan"
                        fi
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'compliance-*.xml,compliance-*.html', allowEmptyArchive: true
                }
            }
        }
        
        // =====================================================================
        // Stage 8: Integration Tests
        // =====================================================================
        stage('Integration Tests') {
            steps {
                sh './gradlew integrationTest --no-daemon --stacktrace'
            }
            post {
                always {
                    junit testResults: '**/build/test-results/integrationTest/*.xml', allowEmptyResults: true
                }
                failure {
                    notifySlack('❌ Integration Tests Failed', 'danger')
                }
            }
        }
        
        // =====================================================================
        // Stage 9: Build Docker Images
        // =====================================================================
        stage('Build Images') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                    branch 'release/*'
                }
            }
            steps {
                script {
                    def services = [
                        'product-service',
                        'order-service',
                        'inventory-service',
                        'sales-service',
                        'procurement-service',
                        'customer-service',
                        'supplier-service',
                        'business-partner-service',
                        'admin-service',
                        'auth-service',
                        'finance-service',
                        'gateway-service',
                        'config-service',
                        'registry-service'
                    ]
                    
                    services.each { service ->
                        echo "Building Docker image for ${service}..."
                        sh """
                            docker build \
                                --build-arg SERVICE_NAME=${service} \
                                --build-arg VERSION=${IMAGE_TAG} \
                                -t ${DOCKER_REGISTRY}/${service}:${IMAGE_TAG} \
                                -f core-services/${service}/Dockerfile \
                                core-services/${service}
                        """
                    }
                }
            }
        }
        
        // =====================================================================
        // Stage 10: Push Docker Images
        // =====================================================================
        stage('Push Images') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                script {
                    docker.withRegistry("https://${DOCKER_REGISTRY}", 'docker-registry-credentials') {
                        def services = [
                            'product-service', 'order-service', 'inventory-service',
                            'sales-service', 'procurement-service', 'customer-service',
                            'supplier-service', 'business-partner-service', 'admin-service',
                            'auth-service', 'finance-service', 'gateway-service',
                            'config-service', 'registry-service'
                        ]
                        
                        services.each { service ->
                            sh """
                                docker push ${DOCKER_REGISTRY}/${service}:${IMAGE_TAG}
                                docker tag ${DOCKER_REGISTRY}/${service}:${IMAGE_TAG} ${DOCKER_REGISTRY}/${service}:latest
                                docker push ${DOCKER_REGISTRY}/${service}:latest
                            """
                        }
                    }
                }
            }
        }
        
        // =====================================================================
        // Stage 11: Deploy to Staging
        // =====================================================================
        stage('Deploy to Staging') {
            when {
                branch 'develop'
            }
            steps {
                script {
                    echo "Deploying to Staging environment..."
                    // Add your deployment commands here
                    // sh 'kubectl apply -f k8s/staging/'
                    
                    notifySlack('🚀 Deployed to Staging', 'good')
                }
            }
        }
        
        // =====================================================================
        // Stage 12: Deploy to Production
        // =====================================================================
        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // Production deployment requires manual approval
                    timeout(time: 1, unit: 'HOURS') {
                        input message: 'Deploy to Production?', ok: 'Deploy',
                              submitterParameter: 'APPROVER'
                    }
                    
                    echo "Deploying to Production environment..."
                    echo "Approved by: ${env.APPROVER}"
                    // Add your deployment commands here
                    // sh 'kubectl apply -f k8s/production/'
                    
                    // Create Git tag
                    sh """
                        git tag -a v${BUILD_NUMBER}-${GIT_COMMIT_SHORT} -m "Release ${BUILD_NUMBER}"
                        git push origin v${BUILD_NUMBER}-${GIT_COMMIT_SHORT}
                    """
                    
                    notifySlack('🚀 Deployed to Production', 'good')
                }
            }
        }
        
        // =====================================================================
        // Stage 13: Jira Integration
        // =====================================================================
        stage('Update Jira') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // Extract Jira issue key from commit message
                    def issueKey = env.GIT_COMMIT_MSG =~ /([A-Z]+-\d+)/
                    if (issueKey) {
                        def key = issueKey[0][0]
                        echo "Updating Jira issue: ${key}"
                        
                        // Transition issue to Done
                        jiraTransition(
                            idOrKey: key,
                            transition: 'Done',
                            site: 'Jira'
                        )
                        
                        // Add comment to issue
                        jiraAddComment(
                            idOrKey: key,
                            comment: "Build #${env.BUILD_NUMBER} completed successfully and deployed to production.",
                            site: 'Jira'
                        )
                    }
                }
            }
        }
    }
    
    // =========================================================================
    // Post-build Actions
    // =========================================================================
    post {
        always {
            // Clean workspace
            cleanWs(
                deleteDirs: true,
                notFailBuild: true
            )
        }
        success {
            notifySlack('✅ Build Successful', 'good')
        }
        failure {
            notifySlack('❌ Build Failed', 'danger')
        }
        unstable {
            notifySlack('⚠️ Build Unstable', 'warning')
        }
        aborted {
            notifySlack('🚫 Build Aborted', 'warning')
        }
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

def notifySlack(String message, String color) {
    slackSend(
        color: color,
        channel: '#devops-alerts',
        message: """
${message}

*Job:* ${env.JOB_NAME}
*Build:* #${env.BUILD_NUMBER}
*Branch:* ${env.GIT_BRANCH}
*Commit:* ${env.GIT_COMMIT_SHORT}
*Author:* ${env.GIT_AUTHOR}
*Duration:* ${currentBuild.durationString}
*URL:* ${env.BUILD_URL}
        """.stripIndent(),
        webhookURL: env.SLACK_WEBHOOK
    )
}
