root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{java,kt,kts}]
indent_size = 4
max_line_length = 120

[*.{xml,html,xhtml}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{json,js,ts}]
indent_size = 2

[*.gradle{,.kts}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[build.gradle.kts]
indent_size = 4

[settings.gradle.kts]
indent_size = 4

[gradle.properties]
indent_size = 4
