/**
 * Gradle Initialization Script (Fixed Version)
 * 
 * 功能说明：
 * - 配置全局Maven仓库，包括阿里云镜像和公共仓库
 * - 优化依赖解析性能
 * - 提供跨平台兼容性支持
 * - 添加日志记录和错误处理机制
 * 
 * 修改历史：
 * - 2026-03-15: 初始版本，添加错误处理和日志记录
 * - 2026-03-15: 优化仓库配置，移除重复配置
 * - 2026-03-15: 添加Gradle版本兼容性检查
 */

import org.gradle.api.initialization.Settings
import org.gradle.api.initialization.resolve.RepositoriesMode

// 日志记录器
def logger = settings.logger

// Gradle版本兼容性检查
def gradleVersion = gradle.gradleVersion
logger.lifecycle("正在加载Gradle初始化脚本，当前版本: ${gradleVersion}")

// 验证Gradle版本是否符合最低要求
def minGradleVersion = "8.0"
if (gradleVersion < minGradleVersion) {
    logger.error("警告: 当前Gradle版本 ${gradleVersion} 低于推荐的最低版本 ${minGradleVersion}")
}

try {
    // 配置插件管理仓库（用于插件解析）
    pluginManagement {
        repositories {
            // 阿里云镜像 - 提供国内访问速度优化
            maven {
                name = "AliyunPluginRepository"
                url = uri("https://maven.aliyun.com/repository/public")
            }
            
            // Gradle官方插件门户
            maven {
                name = "GradlePluginPortal"
                url = uri("https://plugins.gradle.org/m2/")
            }
            
            // Maven中央仓库
            mavenCentral()
        }
    }

    // 配置依赖解析仓库（用于项目依赖）
    dependencyResolutionManagement {
        repositoriesMode.set(RepositoriesMode.PREFER_SETTINGS)
        
        repositories {
            // 本地Maven仓库 - 优先级最高
            mavenLocal()
            
            // 阿里云公共仓库 - 提供国内访问速度优化
            maven {
                name = "AliyunPublicRepository"
                url = uri("https://maven.aliyun.com/repository/public")
            }
            
            // Bstek公共仓库 - 特定项目依赖
            maven {
                name = "BstekPublicRepository"
                url = uri("https://nexus.bsdn.org/content/groups/public/")
            }
            
            // Maven中央仓库 - 作为后备
            mavenCentral()
        }
        
        // 配置依赖解析策略
        repositories {
            all {
                // 启用元数据验证
                metadataSources {
                    mavenPom()
                    artifact()
                    ignoreGradleMetadataRedirection()
                }
            }
        }
    }

    // 全局项目配置
    allprojects {
        // 配置项目级别的仓库（作为后备配置）
        repositories {
            mavenLocal()
            maven {
                name = "AliyunRepository"
                url = uri("https://maven.aliyun.com/repository/public")
            }
            maven {
                name = "BstekRepository"
                url = uri("https://nexus.bsdn.org/content/groups/public/")
            }
            mavenCentral()
        }
        
        // 配置构建脚本的仓库
        buildscript {
            repositories {
                maven {
                    name = "AliyunBuildScript"
                    url = uri("https://maven.aliyun.com/repository/public")
                }
                maven {
                    name = "BstekBuildScript"
                    url = uri("https://nexus.bsdn.org/content/groups/public/")
                }
                maven {
                    name = "GradlePluginPortal"
                    url = uri("https://plugins.gradle.org/m2/")
                }
            }
        }
    }

    logger.lifecycle("Gradle初始化脚本加载成功")

} catch (Exception e) {
    logger.error("Gradle初始化脚本加载失败: ${e.message}")
    logger.error("错误堆栈: ", e)
    // 不抛出异常，允许构建继续进行
}

/**
 * 性能优化建议：
 * 1. 启用Gradle守护进程：在gradle.properties中设置org.gradle.daemon=true
 * 2. 配置并行构建：在gradle.properties中设置org.gradle.parallel=true
 * 3. 增加JVM堆内存：在gradle.properties中设置org.gradle.jvmargs=-Xmx2048m
 * 4. 启用配置缓存：在gradle.properties中设置org.gradle.configuration-cache=true
 * 
 * 可维护性建议：
 * 1. 定期更新仓库URL，确保可用性
 * 2. 监控依赖解析性能，及时调整仓库顺序
 * 3. 记录特殊依赖的来源和用途
 * 
 * 安全性建议：
 * 1. 验证依赖的签名和完整性
 * 2. 使用私有仓库管理敏感依赖
 * 3. 定期检查依赖的安全漏洞
 */