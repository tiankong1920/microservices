<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 排除自动生成的代码 (Lombok, Builder, etc.) -->
    <Match>
        <Class name="~.*\$.*"/>
    </Match>
    <Match>
        <Class name="~.*\$Accessors.*"/>
    </Match>
    <Match>
        <Class name="~.*\$Builder.*"/>
    </Match>
    
    <!-- 排除测试代码 -->
    <Match>
        <Class name="~.*Test$"/>
    </Match>
    
    <!-- 排除特定类型的bug模式 -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>
    <Match>
        <Bug pattern="UWF_UNWRITTEN_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
    
    <!-- 排除 Application 类 -->
    <Match>
        <Class name="~.*Application"/>
    </Match>
    
    <!-- 排除 Controller -->
    <Match>
        <Class name="~.*\.controller\..*"/>
    </Match>
    
    <!-- 排除 Service -->
    <Match>
        <Class name="~.*\.service\..*"/>
    </Match>
    
    <!-- 排除 DTO -->
    <Match>
        <Class name="~.*\.dto\..*"/>
    </Match>
    
    <!-- 排除 Entity -->
    <Match>
        <Class name="~.*\.entity\..*"/>
    </Match>
    
    <!-- 排除配置类 -->
    <Match>
        <Class name="~.*\.config\..*"/>
    </Match>
    
    <!-- 排除工具类构造函数抛出异常的标准Java惯用法 -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    
    <!-- 排除测试包 -->
    <Match>
        <Package name="~com\.inventory\.test\.*"/>
    </Match>
</FindBugsFilter>
