<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gradle Dependency Verification Metadata
  依赖签名验证配置文件
  
  功能说明:
  - 验证所有依赖的签名和校验和
  - 确保依赖的完整性和来源可信
  - 防止依赖被篡改或替换
  
  安全级别: lenient
  版本: 1.0
  更新日期: 2026-03-16
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
    
    <configuration>
        <verify-metadata>true</verify-metadata>
        <verify-signatures>false</verify-signatures>
        <verification-mode>lenient</verification-mode>
        
        <key-servers>
            <key-server uri="https://keys.openpgp.org"/>
            <key-server uri="https://keyserver.ubuntu.com"/>
            <key-server uri="https://pgp.mit.edu"/>
        </key-servers>
        
        <trusted-artifacts>
            <trust group="com.inventory" name=".*" version=".*" file=".*" regex="true"/>
            <trust group=".*" name=".*" version=".*-SNAPSHOT" file=".*" regex="true"/>
            <trust group=".*" name=".*" version=".*-LOCAL" file=".*" regex="true"/>
        </trusted-artifacts>
        
        <ignored-keys>
        </ignored-keys>
    </configuration>
    
</verification-metadata>
