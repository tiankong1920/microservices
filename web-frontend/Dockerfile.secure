# Security scan stage - 用于CI/CD中的安全扫描
FROM node:20-alpine AS security-scan

WORKDIR /app

# 安装 Snyk CLI
RUN npm install -g snyk

COPY package*.json ./
RUN npm ci

COPY . .

# 运行 Snyk 依赖扫描
RUN snyk test --severity-threshold=medium || true

# 运行 Snyk 代码扫描
RUN snyk code test --severity-threshold=medium || true

# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Production stage
FROM nginx:alpine

# 安全加固：更新包并创建非root用户
RUN apk update && apk upgrade --no-cache && \
    addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    chown -R appuser:appgroup /usr/share/nginx/html

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 设置安全标签
LABEL org.opencontainers.image.title="web-frontend" \
      org.opencontainers.image.description="Web Frontend Application" \
      org.opencontainers.image.vendor="Your Company" \
      org.opencontainers.image.version="1.0.0"

EXPOSE 80

# 使用非root用户运行
USER appuser

CMD ["nginx", "-g", "daemon off;"]
